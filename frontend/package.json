{
	"name": "frontend",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "~3.0.8",
		"@sveltejs/kit": "~2.55.0",
		"@sveltejs/vite-plugin-svelte": "~6.2.3",
		"@types/node": "^26.4.0",
		"jsdom": "~30.1.1",
		"svelte": "~5.53.13",
		"svelte-check": "~4.4.5",
		"typescript": "~5.8.3",
		"vite": "~8.0.0",
		"vitest": "~5.0.2"
	},
	"dependencies": {
		"marked": "^18.0.11"
	}
}
