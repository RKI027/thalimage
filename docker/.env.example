# Copy to .env, or paste these into Portainer's stack environment editor.

# --- Tailscale ---------------------------------------------------------
# An auth key (tskey-auth-...) or an OAuth client secret. Needed only for
# the node's first authentication.
TS_AUTHKEY=
# The node's name on the tailnet; the app is served at <name>.<tailnet>.ts.net
TS_HOSTNAME=thalimage
# Must already exist in the tailnet ACL policy. Tagged nodes never expire.
TS_TAG=tag:homelab
# Sidecar image version; bump deliberately.
TS_VERSION=v1.102.5

# --- Image ------------------------------------------------------------
THALIMAGE_TAG=latest

# --- Storage ----------------------------------------------------------
# Holds app/ (cache/thumbs, cache/previews and db_backups/, the daily
# database copies), tailscale/ (the node state) and serve.json (copied
# from docker/ before the first deploy). This is what to back up. Can be
# a network share.
THALIMAGE_DATA=/srv/thalimage
# The database itself (thalimage.db + its WAL siblings). Must be on the
# Docker host's local disk: SQLite's WAL mode does not work over NFS.
THALIMAGE_DB_DIR=/var/lib/thalimage
# Host folder holding the images, mounted read-only at /images (see the
# compose file to let Thalimage change files in it).
THALIMAGE_IMAGES=/srv/photos

# --- App --------------------------------------------------------------
# JSON list. Pin the exact MagicDNS name once it is known:
#   ["thalimage.tail1234.ts.net"]
THALIMAGE_ALLOWED_HOSTS=["*.ts.net"]

# Time zone for the daily backup time (and log timestamps).
TZ=UTC

# Owner of the image files on the host: id -u / id -g
PUID=1000
PGID=1000
